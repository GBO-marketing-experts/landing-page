---
import '../styles/global.css';
import satoshiBlack from '../fonts/Satoshi-Black.otf?url';
import satoshiRegular from '../fonts/Satoshi-Regular.otf?url';
const { t, lang, title = t.meta.title } = Astro.props;
const base = import.meta.env.BASE_URL;
const abs = (path) => new URL(path.replace(/^\//, ''), new URL(base, Astro.site)).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href={`${base}logo-gbo-negro.png`} />

    <link rel="alternate" hreflang="es" href={abs("/")} />
    <link rel="alternate" hreflang="en" href={abs("/en/")} />
    <link rel="alternate" hreflang="x-default" href={abs("/")} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.meta.description} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Only the two faces used above the fold. -->
    <link rel="preload" href={satoshiBlack} as="font" type="font/otf" crossorigin />
    <link rel="preload" href={satoshiRegular} as="font" type="font/otf" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">{t.meta.skip}</a>
    <slot />
  </body>
</html>
