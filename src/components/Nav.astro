---
const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const esUrl = base;
const enUrl = `${base}en/`;
const links = [
  { href: `${base}#por-que`, label: t.nav.why },
  { href: `${base}#servicios`, label: t.nav.services },
  { href: `${base}#casos`, label: t.nav.cases },
];
---
<header class="sticky top-0 z-50 bg-paper">
  <div class="shell flex items-center gap-4 py-4">
    <a href={lang === 'es' ? esUrl : enUrl} class="flex-none" aria-label="GBO">
      <img src={`${base}logo-gbo-negro.png`} alt={t.footer.logoAlt} width="118" height="60"
           class="h-7 w-auto md:h-8" />
    </a>

    <nav class="ml-auto hidden items-center gap-2 lg:flex" aria-label={t.nav.menuTitle}>
      {links.map((l) => <a href={l.href} class="pill">{l.label}</a>)}
      <a href={`${base}#contacto`} class="pill-cta" data-cta="contact">{t.nav.contact}</a>
    </nav>

    <!-- Wrapper carries lg:hidden: .pill-cta sets display un-layered, which
         beats Tailwind's layered utilities, so hiding must live on a parent. -->
    <div class="ml-auto lg:hidden">
      <a href={`${base}#contacto`} class="pill-cta !min-h-[44px] !px-4 !py-2" data-cta="contact">
        {t.nav.contact}
      </a>
    </div>

    <button
      id="menu-open"
      type="button"
      class="pill !px-4 lg:ml-0"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="menu"
    >
      <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" fill="none">
        <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.6" />
      </svg>
      <span class="font-mono text-xs tracking-[0.16em] uppercase">{t.nav.menuTitle}</span>
    </button>
  </div>
  <div class="rule"></div>
</header>

<dialog id="menu" class="menu on-ink" aria-label={t.nav.menuTitle}>
  <div class="shell flex min-h-full flex-col py-5">
    <div class="flex items-center gap-4">
      <img src={`${base}logo-gbo-blanco.png`} alt={t.footer.logoAlt} width="118" height="60"
           class="h-7 w-auto" />
      <button id="menu-close" type="button" class="pill ml-auto !px-4">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6" />
        </svg>
        <span class="font-mono text-xs tracking-[0.16em] uppercase">{t.nav.menuClose}</span>
      </button>
    </div>

    <nav class="mt-auto mb-auto py-10" aria-label={t.nav.menuTitle}>
      {links.map((l) => <a href={l.href} class="menu-link" data-menu-dismiss>{l.label}</a>)}
      <a href="#contacto" class="menu-link text-amarillo" data-menu-dismiss data-cta="contact">
        {t.nav.contact}
      </a>
    </nav>

    <div class="rule pt-6">
      <p class="eyebrow mb-3 opacity-70">{t.nav.langTitle}</p>
      <div class="flex gap-2">
        <a href={esUrl} class="pill" aria-current={lang === 'es' ? 'true' : undefined}
           style={lang === 'es' ? 'background:var(--color-paper);color:var(--color-ink)' : undefined}>
          ES — {t.nav.langEs}
        </a>
        <a href={enUrl} class="pill" aria-current={lang === 'en' ? 'true' : undefined}
           style={lang === 'en' ? 'background:var(--color-paper);color:var(--color-ink)' : undefined}>
          EN — {t.nav.langEn}
        </a>
      </div>
    </div>
  </div>
</dialog>

<script>
  // Native <dialog> gives focus trapping, Esc-to-close and focus restore for free.
  const dlg = document.getElementById('menu');
  const openBtn = document.getElementById('menu-open');
  const sync = () => openBtn.setAttribute('aria-expanded', String(dlg.open));

  openBtn.addEventListener('click', () => { dlg.showModal(); sync(); });
  document.getElementById('menu-close').addEventListener('click', () => dlg.close());
  dlg.addEventListener('close', sync);
  dlg.querySelectorAll('[data-menu-dismiss]').forEach((a) =>
    a.addEventListener('click', () => dlg.close())
  );
</script>
