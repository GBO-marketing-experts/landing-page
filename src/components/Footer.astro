---
const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
// GBO: logotipo GBO, Escribenos + Hablemos, "quitamos direccion por ahora",
// and only Instagram / Facebook / YouTube / LinkedIn.
---
<footer class="band on-ink border-t border-paper/15 pt-16 pb-10">
  <div class="shell">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <img src={`${base}logo-gbo-blanco.png`} alt={t.footer.logoAlt} width="236" height="120"
             class="h-12 w-auto" />
        <p class="eyebrow mt-4 opacity-70">{t.footer.tagline}</p>
        <p class="mt-3 font-mono text-xs tracking-[0.1em] uppercase opacity-50">{t.footer.location}</p>
      </div>

      <div class="lg:col-span-4">
        <p class="eyebrow">{t.footer.writeUs}</p>
        <a href="#" data-cta="email"
           class="mt-3 block break-all text-xl font-medium underline decoration-dot decoration-2 underline-offset-[6px]">
          {t.shared.email}
        </a>
        <a href="#contacto" data-cta="contact" class="pill-cta mt-7">
          {t.footer.cta}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="lg:col-span-3 lg:col-start-10">
        <p class="eyebrow">{t.footer.socialLabel}</p>
        <ul class="mt-4 space-y-2">
          {t.shared.socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-2 hover:text-amarillo">
                <span class="h-1.5 w-1.5 rounded-full bg-dot" aria-hidden="true"></span>{s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="rule mt-14 flex flex-col gap-5 pt-6 md:flex-row md:items-center md:justify-between">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs tracking-[0.1em] uppercase opacity-60">
        {t.footer.legal.map((l) => (
          <li><a href="#" data-cta="legal" class="hover:opacity-100">{l}</a></li>
        ))}
      </ul>
      <div class="flex flex-wrap items-center gap-4">
        <p class="font-mono text-xs opacity-50">{t.footer.rights}</p>
        <a href={lang === 'es' ? `${base}en/` : base} class="pill !py-1.5 !text-xs">
          {lang === 'es' ? 'EN' : 'ES'}
        </a>
      </div>
    </div>
  </div>
</footer>
