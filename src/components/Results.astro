---
import RiseText from './RiseText.astro';
const { t } = Astro.props;
// Cambios §8: the real Home is Cool case replaces the unverifiable "+80M".
// Figure +11x, then Reto / Qué hicimos / Resultado, then "Ver caso completo".
---
<section class="band on-ink py-20 md:py-28">
  <div class="shell">
    <div class="text-center">
      <h2 class="t-display t-section mt-4" data-rise>
        <RiseText text={t.results.h2a} /><RiseText text={t.results.h2b} lead /><span class="srise"><span class="dot">.</span></span>
      </h2>
    </div>

    <div class="reveal mt-14 text-center md:mt-20">
      <p class="t-display grad-text leading-[0.85]" style="font-size:clamp(5rem,17vw,13rem)">
        {t.results.figure}
      </p>
      <p class="t-sub mt-4">{t.results.figureCaption}</p>
      <p class="t-lead mx-auto mt-3 max-w-xl text-paper/70">{t.results.figureDetail}</p>
    </div>

    <div class="reveal mx-auto mt-16 grid max-w-5xl gap-10 md:mt-20 md:grid-cols-3">
      {t.results.case.map((c) => (
        <div class="rule pt-6">
          <p class="font-mono text-xs tracking-[0.16em] uppercase text-dot">{c.label}</p>
          <p class="mt-3 text-paper/80">{c.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-14 text-center">
      <a href="#" data-cta="case" class="pill">{t.results.cta}</a>
    </div>
  </div>
</section>
